# GEMINI_API_KEY: Required for server-side Gemini AI ("Mein Kanaren-Reiseberater") calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Required for Google Maps Platform (Maps JS, Routes, Places, Elevation).
# Provisioned via Google Maps setup or configured in Secrets.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
